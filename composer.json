{
    "name": "ce-phoenixcart/phoenix-cart-tests",
    "description": "PHPUnit harness for CE Phoenix Cart",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload-dev": {
