{
    "name": "ce-phoenixcart/phoenix-cart-tests",
    "description": "PHPUnit harness for CE Phoenix Cart",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/http-client": "^7.2",
        "symfony/mime": "^7.2"
    },
    "autoload-dev": {
        "psr-4": {
            "PhoenixCart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:mysql": "phpunit --testsuite integration",
        "test:http": "phpunit --testsuite http",
        "test:https": "phpunit --testsuite https",
        "test:all": "phpunit --testsuite all",
        "test:stack": "phpunit --testsuite stack",
        "test:browser": "npx playwright test",
        "test:payment-sandbox": "phpunit --group payment_sandbox",
        "test:installer": "bash scripts/run-installer-tests.sh",
        "cloud-test": "bash .cursor/scripts/cloud-test.sh",
        "release-certify": "bash scripts/release-certification.sh"
    },
    "config": {
        "sort-packages": true
    }
}
