{
    "name": "ce-phoenixcart/phoenix-cart-tests",
    "description": "PHPUnit harness for CE Phoenix Cart",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/http-client": "^7.2"
    },
    "autoload-dev": {
        "psr-4": {
            "PhoenixCart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test:mysql": "phpunit --testsuite Integration",
        "test:http": "phpunit --testsuite Http",
        "test:all": "phpunit",
        "test:stack": "phpunit --testsuite Unit --testsuite Integration --testsuite Http",
        "test:browser": "npx playwright test",
        "cloud-test": "bash .cursor/scripts/cloud-test.sh"
    },
    "config": {
        "sort-packages": true
    }
}
